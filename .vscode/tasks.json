{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "path": "csharp-test-filter/",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "compile",
      "path": "csharp-test-filter/",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "never"
      },
      "group": "build"
    },
    {
      "type": "npm",
      "script": "lint",
      "path": "csharp-test-filter/",
      "problemMatcher": "$eslint-stylish",
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "dotnet: build gengora server",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/gengora/server"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$msCompile"],
      "options": { "cwd": "${workspaceFolder}/gengora/server" }
    },
    {
      "label": "dotnet: build gengora generator",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/gengora/test-workspace/SampleGenerator"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$msCompile"],
      "options": { "cwd": "${workspaceFolder}/gengora/test-workspace" }
    },
    {
      "label": "npm: build gengora extension",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$tsc"],
      "options": { "cwd": "${workspaceFolder}/gengora/extension" }
    },
    {
      "label": "npm: watch gengora extension",
      "type": "shell",
      "command": "npx",
      "args": ["tsc", "-p", ".", "--watch"],
      "presentation": { "reveal": "never", "panel": "shared" },
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}/gengora/extension" }
    },
    {
      "label": "build-gengora-all",
      "dependsOn": ["dotnet: build gengora server", "dotnet: build gengora generator", "npm: build gengora extension"],
      "dependsOrder": "sequence",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
