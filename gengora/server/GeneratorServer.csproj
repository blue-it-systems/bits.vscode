<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BITS.Gengora.Server</AssemblyName>
    <RootNamespace>BITS.Gengora.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- use the latest compatible OmniSharp.Extensions.LanguageServer package available on nuget.org -->
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.4.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.7.0" />
  </ItemGroup>
</Project>
