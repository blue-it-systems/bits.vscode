<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BITS.Gengora.Server</AssemblyName>
    <RootNamespace>BITS.Gengora.Server</RootNamespace>
  </PropertyGroup>

  <!-- Release build optimizations -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Exclude localization satellite assemblies -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    
    <!-- Trimming & AOT optimizations -->
    <PublishTrimmed>false</PublishTrimmed> <!-- Can't trim LSP server, Roslyn uses reflection -->
    <TrimMode>copyused</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    
    <!-- Size optimizations -->
    <DebugType>none</DebugType> <!-- No PDB files in Release -->
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    
    <!-- Remove XML docs -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- OmniSharp.Extensions.LanguageServer 0.19.9 works with .NET 10 but needs compatible MSBuild packages -->
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
  </ItemGroup>
  
</Project>
