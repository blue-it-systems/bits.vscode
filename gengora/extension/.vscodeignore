# VS Code Extension Ignore File     
# Files and folders listed here will not be included in the packaged extension

# Test output directories - VS Code test framework downloads (MUST be first!)
.vscode-test/**

# Source files (compiled output in /out is included)
src/**
**/*.ts
!**/*.d.ts

# Test files
**/*.test.js
**/test/**
.vscode-test.mjs
.vscode-test.mts

# Development configuration
.vscode/**
tsconfig.json
.eslintrc*
eslint.config.*

# Package management - KEEP node_modules for runtime dependencies!
# node_modules/** - DO NOT EXCLUDE, we need vscode-languageclient
package-lock.json

# Exclude dev dependencies from node_modules
node_modules/@types/**
node_modules/@typescript-eslint/**
node_modules/@vscode/test-cli/**
node_modules/@vscode/test-electron/**
node_modules/@vscode/vsce/**
node_modules/eslint/**
node_modules/typescript/**
node_modules/@eslint/**
node_modules/globals/**
node_modules/@secretlint/**

# Git
.git/**
.gitignore
.gitattributes

# Build artifacts
*.vsix
*.map

# Development files
.DS_Store
Thumbs.db
*.log
*.tmp

# Samples - exclude build artifacts but keep source
samples/**/*.obj
samples/**/bin/**
samples/**/obj/**

# Server PDB files (debug symbols not needed in production)
server/*.pdb