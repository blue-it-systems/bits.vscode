<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- REQUIRED: This marker tells Gengora this is a generator project -->
    <IsGeneratorProject>true</IsGeneratorProject>
    
    <!-- Optional: Assembly information -->
    <AssemblyName>BasicGenerator</AssemblyName>
    <RootNamespace>BasicGenerator</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Your Name</Authors>
    <Description>A sample Gengora code generator</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Gengora abstractions for type-safe development -->
    <ProjectReference Include="..\..\Gengora.Generator.Abstractions\Gengora.Generator.Abstractions.csproj" 
                      Condition="Exists('..\..\Gengora.Generator.Abstractions\Gengora.Generator.Abstractions.csproj')" />
  </ItemGroup>

</Project>
