<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    
    <!-- Package Information -->
    <PackageId>Gengora.Generator.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Authors>Blue IT Systems GmbH</Authors>
    <Company>Blue IT Systems GmbH</Company>
    <Description>Type-safe abstractions for building Gengora code generators. Provides interfaces and helper classes for communicating with the Gengora VS Code extension server.</Description>
    <PackageTags>gengora;code-generation;roslyn;dotnet;generator</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/blue-it-systems/bits.vscode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/blue-it-systems/bits.vscode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Assembly Information -->
    <AssemblyName>Gengora.Generator.Abstractions</AssemblyName>
    <RootNamespace>Gengora.Generator</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
